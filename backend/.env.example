APP_ENV=development
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
MAX_RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=2.0
RISK_CAPITAL_USD=80.0
GOLD_SPOT_API_URL=https://api.gold-api.com/price/XAU
MARKET_QUOTE_MAX_AGE_SECONDS=300
MT5_BRIDGE_TOKEN=replace_with_a_long_random_secret

BROKER_GOLD_SYMBOL=GOLD

# Optional economic calendar (Trading Economics API key; keep the real key private)
ECONOMIC_CALENDAR_API_KEY=replace_with_your_calendar_api_key
ECONOMIC_CALENDAR_BASE_URL=https://api.tradingeconomics.com
NEWS_BLACKOUT_BEFORE_MINUTES=30
NEWS_BLACKOUT_AFTER_MINUTES=30
FRED_API_KEY=replace_with_your_fred_api_key
